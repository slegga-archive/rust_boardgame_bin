' ================= 6. Kjoreflyt for ett parti (run_match) =================

@startuml
title 6. Kjoreflyt for ett parti (run_match)

participant "bin (f.eks. game_match)" as B
participant "game_utils.run_match" as U
participant "Game / Connect4" as G
participant "player_a (Agentish)" as A
participant "player_b (Agentish)" as C

B -> U : run_match(game, player_a, player_b)
U -> G : get_game_static()
loop til is_terminal()
  U -> G : get_active_player()
  U -> G : get_valid_moves()
  alt spiller A sin tur
    U -> A : get_move(valid_moves, player, game)
    A --> U : cmove
  else spiller B sin tur
    U -> C : get_move(valid_moves, player, game)
    C --> U : cmove
  end
  U -> G : play(cmove)
end
U -> G : get_winner()
G --> U : winner
U --> B : vinner-indeks (u8)
@enduml
