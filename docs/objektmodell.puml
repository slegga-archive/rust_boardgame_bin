' Objekt- og filmodell for rust_boardgame_*-repoene
' Samme modell som objektmodell.md (Mermaid), i PlantUML-format.
' Render: plantuml objektmodell.puml   (lager ett bilde per @startuml-blokk)
' Merk: filen inneholder flere @startuml-blokker, ett diagram per avsnitt.

' ================= 1. Avhengigheter mellom crates =================

@startuml
title 1. Avhengigheter mellom crates

package "rust_boardgame_game (crate: boardgame_game)" as GAME {
  [lib.rs -> game/] as lib_game
}

package "rust_boardgame_player (crate: boardgame_player)" as PLAYER {
  [lib.rs -> player/] as lib_player
}

package "rust_boardgame_bin (crate: boardgame_binaries)" as BIN {
  [6 x bin + game_utils] as bins
}

lib_player --> lib_game : path dependency
bins --> lib_game : path dependency
bins --> lib_player : path dependency
@enduml

