' ================= 3. Objektmodell spill (boardgame_game) =================

@startuml
title 3. Objektmodell spill (boardgame_game)

interface Playable {
  +reset()
  +get_game_static() : GameStatic
  +get_valid_moves() : Vec<String>
  +is_terminal() : bool
  +get_winner() : Option<String>
  +get_active_player() : String
  +play(play_move : str)
  +get_bit_state(perspective : str) : Vec<bool>
  +get_bit_state_from_bit_state_and_move(perspective, tmp_state, cmove) : Vec<bool>
  +get_valid_moves_from_bit_state(perspective, tmp_state) : Vec<String>
  +pretty_print()
}

class GameStatic {
  +name : String
  +players : Vec<String>
  -state_size : usize
  +new(name, players, state_size) : GameStatic
  +get_state_size() : usize
}

enum Game {
  Connect4(&mut Connect4)
  Nim12(&mut Nim12)
}

enum TerminalState {
  Me
  Opponent
  Draw
}

class Connect4 {
  -turn : C4Player
  -table : u8[7][6]
  -is_terminated : bool
  -winner : Option<C4Player>
  -last_printed_table : u8[7][6]
}

enum C4Player {
  Red
  Yellow
}

class Nim12 {
  -turn : bool
  -tokens_left : u8
}

class "game::hjelpefunksjoner" as gf {
  +{static} get_terminal_state_from_bit_state(state) : Option<TerminalState>
  +{static} get_active_player_from_bit_state(game_static, state) : String
}

Connect4 ..|> Playable
Nim12 ..|> Playable
Game ..|> Playable : dispatch paa variant
Game o-- Connect4 : holder mut ref
Game o-- Nim12 : holder mut ref
Connect4 *-- C4Player : tur og vinner
Connect4 ..> GameStatic : get_game_static
Nim12 ..> GameStatic : get_game_static
Playable ..> GameStatic : get_game_static
gf ..> TerminalState : returnerer
gf ..> GameStatic : leser players
@enduml

' ================= 4. Objektmodell spillere og hjerner (boardgame_player) =================

@startuml
title 4. Objektmodell spillere og hjerner (boardgame_player)

interface Agentish {
  +get_move(moves, game_player, game : T) : Option<String>
  +get_name() : String
  +get_ready(game_static, me_color, sec_to_move) : Result<LogicGatesError>
}

interface Brainy {
  +evaluate_bit_state(game : Game, bit_state) : usize
  +get_brain() : MyBrain
}

class PlayerNNDiamond {
  +name : String
  +is_loaded : bool
  +brain : BrainDiamond
}

class PlayerNNDiamondTS {
  +name : String
  +is_loaded : bool
  +brain : BrainDiamond
  +sec_to_move : u64
  +me_color : String
  +opponent_color : String
  -has_time_left(move_start) : bool
  -select_leaf(states) : (usize, Option<TSNode>, bool)
  -explore(game, states)
  -backpropagate(states)
  -add_leaf(states)
  -get_best_move_and_score(states)
  +transform_to_mocked_version()
}

class TSNode {
  <<internt>>
  -moves : HashMap<String, usize>
  -score : usize
  -best_move : Option<String>
  -bit_state : Vec<bool>
  -is_open : bool
  -level : u8
  -player : String
  -score_level : u8
  -score_address : usize
}

class PlayerRandom {
  +name : String
  +name_in_game : String
}

class PlayerHuman {
  +name : String
}

class BrainDiamond {
  +game_name : String
  +filepath : String
  +layers : [Vec<Cell>; 6]
  +evaluate_bit_state(bit_state) : usize
  +get_gate_result_for_level(bit_state, level) : Vec<bool>
  +do_mutate(max_address)
  +from_file() : Result<LogicGatesError>
  +save_to_file() : Result<LogicGatesError>
}

class Cell {
  +address_a : usize[256]
  +address_b : usize[256]
  +operator : BitOp[256]
}

enum BitOp {
  FALSE
  AND
  XOR
  OR
  NAND
  TRUE
  ... 10 til
}

enum LogicGatesError {
  InvalidBitOperator
  Io
  InvalidChar
  General
}

class "brain::hjelpefunksjoner" as bf {
  +{static} get_default_cell_layer(layer) : Vec<Cell>
  +{static} generate_random_cell_layer(max_address, layer) : Vec<Cell>
  +{static} generate_random_brain(game_static) : BrainDiamond
}

PlayerNNDiamond ..|> Agentish
PlayerNNDiamondTS ..|> Agentish
PlayerRandom ..|> Agentish
PlayerHuman ..|> Agentish
PlayerNNDiamond ..|> Brainy : MyBrain = BrainDiamond
PlayerNNDiamondTS ..|> Brainy : MyBrain = BrainDiamond

PlayerNNDiamond *-- BrainDiamond
PlayerNNDiamondTS *-- BrainDiamond
PlayerNNDiamondTS o-- TSNode : soketree over stillinger
BrainDiamond *-- Cell : 6 lag a 256 porter
Cell *-- BitOp : operator per port

BrainDiamond ..> LogicGatesError : returnerer
bf ..> Cell : bygger lag
bf ..> BrainDiamond : returnerer
Agentish ..> Playable : get_move tar generisk T
Brainy ..> Game : evaluate_bit_state tar Game
@enduml

' ================= 5. Objektmodell bin og game_utils (boardgame_binaries) =================

@startuml
title 5. Objektmodell bin og game_utils (boardgame_binaries)

class Statistics {
  -states : Vec<Evaluate>
  +winner : usize
  -rank_gates : Vec<usize>
  +dump()
  +calculate()
  +dump_rank_gates()
}

class Evaluate {
  -move_number : usize
  -move_string : String
  -apprentice_score : usize
  -master_score : usize
  -gate_result : Vec<bool>
  -game_bit_state : Vec<bool>
}

class "game_utils::funksjoner" as gu {
  +{static} run_match(game : T, player_a, player_b) : u8
  +{static} mass_run_match_with_random_player(game : T, player, tot_matches) : f32
  +{static} run_match_return_statistics(game : Game, master, apprentice) : Statistics
}

Statistics *-- Evaluate : ett per trekk
gu ..> Statistics : returnerer
gu ..> Evaluate : fyller ut per trekk
@enduml

